POSTGRES_DB=dateplanner_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Nombre exacto obtenido con `docker inspect` o `docker volume ls` en el VPS.
POSTGRES_VOLUME_NAME=replace-with-existing-volume-name

AUTHENTICATION_KEY=replace-with-at-least-32-random-characters
AUTHENTICATION_ISSUER=Entrelazados
AUTHENTICATION_AUDIENCE=Entrelazados
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

APP_PORT=8080

DATEPLANNER_API_IMAGE=dateplanner-api:prod
DATEPLANNER_APP_IMAGE=dateplanner-app:prod
